# ---------------------------------------------------------------------------
# AI Virtual Office - backend configuration
# Copy to .env and adjust. Every value below has a working default.
# ---------------------------------------------------------------------------

ENVIRONMENT=development          # development | staging | production
DEBUG=true

# --- Database --------------------------------------------------------------
# SQLite (zero setup, the default if unset):
#   DATABASE_URL=sqlite:///./virtual_office.db
# PostgreSQL:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/virtual_office
SQL_ECHO=false

# --- Security --------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- LLM (optional) --------------------------------------------------------
# With no key the app runs its deterministic analysis engine - fully functional,
# no network calls, no cost. Add a key to switch the agents onto Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_MAX_TOKENS=8000
LLM_ENABLED=true

# --- Knowledge base --------------------------------------------------------
MAX_UPLOAD_BYTES=20971520        # 20 MB
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=6

# --- Seeding ---------------------------------------------------------------
SEED_ON_STARTUP=true             # seeds a demo workspace on an empty database
DEMO_EMAIL=founder@northwind.io
DEMO_PASSWORD=demo1234
