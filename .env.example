# ---------------------------------------------------------------------------
# docker compose configuration. Copy to .env and edit.
# For running the backend directly (not in Docker), see backend/.env.example.
# ---------------------------------------------------------------------------

# Web
WEB_PORT=8080

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=virtual_office

# Security - generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 bytes when ENVIRONMENT=production, or the API refuses to boot.
SECRET_KEY=change-me-to-a-long-random-value-at-least-32-bytes

ENVIRONMENT=development
DEBUG=false

# LLM - optional. Without a key the deterministic engine runs instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Seed a demo workspace on an empty database.
SEED_ON_STARTUP=true
